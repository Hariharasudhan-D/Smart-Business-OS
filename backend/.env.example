# Copy to backend/.env and fill in DB_PASSWORD. Do not commit .env. No quotes around values.
# From your Supabase "Session pooler" connection string (port 5432):
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.vukclswovxbfweciqtlf
DB_PASSWORD=your-database-password
DB_SSLMODE=require

