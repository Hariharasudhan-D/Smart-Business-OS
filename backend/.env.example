# Copy to backend/.env and fill in the secrets. Do not commit .env. No quotes around values.

# The Geethu's Corner Supabase project (the same database as the website).
# Connect > Session pooler (port 5432). Keep the same shape as the example.
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Signs the OS login tokens. Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different value from the website's JWT secret so the two systems stay separate.
JWT_SECRET=replace-with-a-long-random-string

# How many days a sign-in lasts
AUTH_TOKEN_DAYS=7
# How long a phone-app sign-in lasts before it must be renewed (the app renews it while in use).
AUTH_APP_TOKEN_DAYS=90

# Browser origins allowed to call the API directly (the Vite dev server proxies, so this is optional).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
